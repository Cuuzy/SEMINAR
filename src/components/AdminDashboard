import React, { useState, useEffect } from 'react';
import {
  Users, Edit, FileSpreadsheet, Plus, Trash2, CheckCircle2, XCircle, Search, RefreshCw,
  LogOut, Save, Calendar, MapPin, Clock, Shield, AlertCircle, Eye, ChevronRight, UserPlus,
  BarChart3, Sparkles, Filter, Phone, Mail, Check, HelpCircle, TrendingUp, Tag, Gift,
  Award, UserCheck, Star, Layers, ListOrdered, Mic, MessageSquare, Globe, Camera, Image, X,
  Building2, AlertTriangle, Loader2, CheckSquare, QrCode
} from 'lucide-react';
import { EventContent, Participant, UpcEvent } from '../types';
import { QrCheckInModal } from './QrCheckInModal';

interface AdminDashboardProps {
  token: string;
  onLogout: () => void;
  onContentUpdated: () => void;
}

export const AdminDashboard: React.FC<AdminDashboardProps> = ({
  token,
  onLogout,
  onContentUpdated
}) => {
  const [activeTab, setActiveTab] = useState<'participants' | 'upc-events' | 'content' | 'stats'>('participants');
  
  // Data states
  const [participants, setParticipants] = useState<Participant[]>([]);
  const [content, setContent] = useState<EventContent | null>(null);
  const [loading, setLoading] = useState(true);
  const [savingContent, setSavingContent] = useState(false);
  const [notification, setNotification] = useState<{ type: 'success' | 'error'; message: string } | null>(null);

  // QR Scanner Modal State
  const [showQrScanner, setShowQrScanner] = useState(false);

  // Search & Filter state
  const [searchQuery, setSearchQuery] = useState('');
  const [statusFilter, setStatusFilter] = useState<string>('ALL');
  const [branchFilter, setBranchFilter] = useState<string>('ALL');

  // UPC Seminar Event Modal State
  const [showUpcModal, setShowUpcModal] = useState(false);
  const [editingUpcId, setEditingUpcId] = useState<string | null>(null);
  const [upcForm, setUpcForm] = useState<UpcEvent>({
    id: '',
    upcName: 'CP Ciledug',
    code: 'CP-CLDG',
    title: '',
    eventDate: '',
    eventTime: '09:00 - 12:00 WIB',
    venueName: '',
    address: '',
    mapUrl: '',
    quota: 50,
    registered: 0,
    contactPerson: '',
    contactPhone: '',
    status: 'OPEN',
    description: '',
    specialBenefits: []
  });
  const [benefitInput, setBenefitInput] = useState('');

  // Manual Add Modal State
  const [showAddModal, setShowAddModal] = useState(false);
  const [manualForm, setManualForm] = useState({
    fullName: '',
    phone: '',
    email: '',
    occupation: 'Karyawan Swasta',
    branch: 'Pegadaian CP Senen',
    investmentGoal: 'Tabungan Masa Depan',
    attendanceCount: 1,
    notes: 'Diinput manual oleh Admin',
    status: 'Verified' as const
  });

  // Selected Participant Detail Modal State
  const [selectedParticipant, setSelectedParticipant] = useState<Participant | null>(null);

  // Selected Participants for Batch Operations (Delete)
  const [selectedParticipantIds, setSelectedParticipantIds] = useState<string[]>([]);

  // Delete Confirmation Modal State
  const [deleteConfirmModal, setDeleteConfirmModal] = useState<{
    isOpen: boolean;
    title: string;
    description: string;
    ids: string[];
    itemsPreview: { id: string; name: string; code: string; branch: string; status: string }[];
    isDeleting: boolean;
  } | null>(null);

  // Fetch all initial data
  const fetchData = async () => {
    setLoading(true);
    try {
      // Fetch Content
      const resContent = await fetch('/api/content');
      const dataContent = await resContent.json();
      if (dataContent.success) {
        setContent(dataContent.data);
      }

      // Fetch Participants
      const resP = await fetch('/api/participants', {
        headers: { Authorization: `Bearer ${token}` }
      });
      const dataP = await resP.json();
      if (dataP.success) {
        setParticipants(dataP.participants);
      }
    } catch (err: any) {
      showNotice('error', 'Gagal memuat data admin: ' + err.message);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, [token]);

  const showNotice = (type: 'success' | 'error', message: string) => {
    setNotification({ type, message });
    setTimeout(() => setNotification(null), 4000);
  };

  // --- HANDLERS UNTUK ACARA SEMINAR PER CABANG / UPC ---
  const handleOpenAddUpc = () => {
    setEditingUpcId(null);
    setUpcForm({
      id: '',
      upcName: 'CP Ciledug',
      code: 'CP-CLDG',
      title: 'Gathering & Edukasi Investasi Emas',
      eventDate: 'Kamis, 20 Agustus 2026',
      eventTime: '09:00 - 12:00 WIB',
      venueName: 'Gedung Pertemuan Pegadaian',
      address: 'Jl. Raya Utama Pegadaian',
      mapUrl: 'https://maps.google.com',
      quota: 50,
      registered: 0,
      contactPerson: 'Penanggung Jawab Acara',
      contactPhone: '6281234567890',
      status: 'OPEN',
      description: 'Sesi edukasi investasi emas, tabungan emas, dan promo khusus bagi peserta gathering.',
      specialBenefits: ['Gratis Tabungan Emas', 'Snack Box & Souvenir']
    });
    setBenefitInput('');
    setShowUpcModal(true);
  };

  const handleOpenEditUpc = (evt: UpcEvent) => {
    setEditingUpcId(evt.id);
    setUpcForm({ ...evt, specialBenefits: evt.specialBenefits || [] });
    setBenefitInput('');
    setShowUpcModal(true);
  };

  const handleSaveUpcEvent = async () => {
    if (!content) return;
    if (!upcForm.upcName || !upcForm.title || !upcForm.eventDate || !upcForm.venueName) {
      showNotice('error', 'Harap isi nama Cabang/UPC, judul seminar, tanggal, dan lokasi venue!');
      return;
    }

    const currentList = content.upcEvents || [];
    let updatedList: UpcEvent[] = [];

    if (editingUpcId) {
      updatedList = currentList.map(e => (e.id === editingUpcId ? { ...upcForm } : e));
    } else {
      const newId = 'upc-' + Date.now();
      const newEvent: UpcEvent = {
        ...upcForm,
        id: newId,
        code: upcForm.code || `UPC-${Math.floor(100 + Math.random() * 900)}`
      };
      updatedList = [newEvent, ...currentList];
    }

    const updatedContent = {
      ...content,
      upcEvents: updatedList
    };

    setContent(updatedContent);

    try {
      const res = await fetch('/api/content', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify(updatedContent)
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.message || 'Gagal menyimpan acara.');

      showNotice('success', editingUpcId ? 'Jadwal seminar berhasil diperbarui!' : 'Jadwal seminar baru berhasil dibuat!');
      setShowUpcModal(false);
      onContentUpdated();
    } catch (err: any) {
      showNotice('error', err.message);
    }
  };

  const handleDeleteUpcEvent = async (id: string) => {
    if (!content) return;
    if (!confirm('Apakah Anda yakin ingin menghapus jadwal acara seminar ini?')) return;

    const updatedList = (content.upcEvents || []).filter(e => e.id !== id);
    const updatedContent = { ...content, upcEvents: updatedList };
    setContent(updatedContent);

    try {
      const res = await fetch('/api/content', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify(updatedContent)
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.message);

      showNotice('success', 'Acara seminar berhasil dihapus.');
      onContentUpdated();
    } catch (err: any) {
      showNotice('error', err.message);
    }
  };

  // --- EXCEL EXPORT HANDLER ---
  const handleExportExcel = () => {
    window.open(`/api/export/excel?token=${encodeURIComponent(token)}`, '_blank');
    showNotice('success', 'File Excel (.xlsx) data peserta berhasil diunduh!');
  };

  // --- CONTENT EDIT SAVE ---
  const handleSaveContent = async () => {
    if (!content) return;
    setSavingContent(true);

    try {
      const res = await fetch('/api/content', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify(content)
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.message || 'Gagal menyimpan perubahan.');
      }

      showNotice('success', 'Pengaturan Landing Page berhasil diperbarui!');
      onContentUpdated();
    } catch (err: any) {
      showNotice('error', err.message);
    } finally {
      setSavingContent(false);
    }
  };

  // --- CHANGE PARTICIPANT STATUS ---
  const handleUpdateStatus = async (id: string, newStatus: Participant['status']) => {
    try {
      const res = await fetch(`/api/participants/${id}/status`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify({ status: newStatus })
      });

      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.message);

      setParticipants(prev =>
        prev.map(p => (p.id === id ? { ...p, status: newStatus } : p))
      );
      showNotice('success', `Status peserta berhasil diubah menjadi ${newStatus}.`);
    } catch (err: any) {
      showNotice('error', err.message);
    }
  };

  // --- DELETE PARTICIPANTS OPTIMIZED LOGIC ---
  const openDeleteSingleModal = (participant: Participant) => {
    setDeleteConfirmModal({
      isOpen: true,
      title: 'Hapus Data Peserta',
      description: `Apakah Anda yakin ingin menghapus data peserta "${participant.fullName}" (${participant.registrationCode})?`,
      ids: [participant.id],
      itemsPreview: [{
        id: participant.id,
        name: participant.fullName,
        code: participant.registrationCode,
        branch: participant.branch,
        status: participant.status
      }],
      isDeleting: false
    });
  };

  const openDeleteBatchModal = () => {
    if (selectedParticipantIds.length === 0) return;
    const selectedParticipants = participants.filter(p => selectedParticipantIds.includes(p.id));
    setDeleteConfirmModal({
      isOpen: true,
      title: `Hapus ${selectedParticipantIds.length} Peserta Terpilih`,
      description: `Konfirmasi penghapusan ${selectedParticipantIds.length} peserta terpilih dari database server.`,
      ids: selectedParticipantIds,
      itemsPreview: selectedParticipants.map(p => ({
        id: p.id,
        name: p.fullName,
        code: p.registrationCode,
        branch: p.branch,
        status: p.status
      })),
      isDeleting: false
    });
  };

  const openDeleteCancelledModal = () => {
    const cancelled = participants.filter(p => p.status === 'Cancelled');
    if (cancelled.length === 0) return;
    setDeleteConfirmModal({
      isOpen: true,
      title: `Hapus Semua (${cancelled.length}) Peserta Batal`,
      description: `Tindakan ini akan menghapus seluruh ${cancelled.length} peserta berstatus 'Cancelled' secara permanen dari database.`,
      ids: cancelled.map(p => p.id),
      itemsPreview: cancelled.map(p => ({
        id: p.id,
        name: p.fullName,
        code: p.registrationCode,
        branch: p.branch,
        status: p.status
      })),
      isDeleting: false
    });
  };

  const executeDeleteConfirm = async () => {
    if (!deleteConfirmModal || deleteConfirmModal.ids.length === 0) return;

    setDeleteConfirmModal(prev => prev ? { ...prev, isDeleting: true } : null);

    try {
      const isBatch = deleteConfirmModal.ids.length > 1;
      let res;
      if (isBatch) {
        res = await fetch('/api/participants/batch-delete', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${token}`
          },
          body: JSON.stringify({ ids: deleteConfirmModal.ids })
        });
      } else {
        res = await fetch(`/api/participants/${deleteConfirmModal.ids[0]}`, {
          method: 'DELETE',
          headers: { Authorization: `Bearer ${token}` }
        });
      }

      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.message);

      const deletedIdsSet = new Set(deleteConfirmModal.ids);
      setParticipants(prev => prev.filter(p => !deletedIdsSet.has(p.id)));
      setSelectedParticipantIds(prev => prev.filter(id => !deletedIdsSet.has(id)));
      if (selectedParticipant && deletedIdsSet.has(selectedParticipant.id)) {
        setSelectedParticipant(null);
      }

      showNotice('success', isBatch ? `${deleteConfirmModal.ids.length} data peserta berhasil dihapus.` : 'Data peserta berhasil dihapus.');
      setDeleteConfirmModal(null);
    } catch (err: any) {
      showNotice('error', err.message);
      setDeleteConfirmModal(prev => prev ? { ...prev, isDeleting: false } : null);
    }
  };

  // --- ADD MANUAL PARTICIPANT ---
  const handleAddManualParticipant = async (e: React.FormEvent) => {
    e.preventDefault();
    try {
      const res = await fetch('/api/participants/manual', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify(manualForm)
      });

      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.message);

      setParticipants(prev => [data.participant, ...prev]);
      setShowAddModal(false);
      showNotice('success', 'Peserta manual berhasil ditambahkan!');
      setManualForm({
        fullName: '',
        phone: '',
        email: '',
        occupation: 'Karyawan Swasta',
        branch: 'Pegadaian CP Senen',
        investmentGoal: 'Tabungan Masa Depan',
        attendanceCount: 1,
        notes: 'Diinput manual oleh Admin',
        status: 'Verified'
      });
    } catch (err: any) {
      showNotice('error', err.message);
    }
  };

  // --- CONTENT ARRAY HELPERS ---
  const handleAddBenefit = () => {
    if (!content) return;
    const newB = {
      id: 'b_' + Date.now(),
      title: 'Fasilitas / Keuntungan Baru',
      description: 'Penjelasan fasilitas atau benefit yang akan diperoleh peserta.',
      iconName: 'Sparkles'
    };
    setContent({ ...content, benefits: [...(content.benefits || []), newB] });
  };

  const handleUpdateBenefit = (index: number, field: string, value: string) => {
    if (!content) return;
    const updated = [...(content.benefits || [])];
    updated[index] = { ...updated[index], [field]: value };
    setContent({ ...content, benefits: updated });
  };

  const handleDeleteBenefit = (index: number) => {
    if (!content) return;
    const updated = (content.benefits || []).filter((_, i) => i !== index);
    setContent({ ...content, benefits: updated });
  };

  const handleAddSpeaker = () => {
    if (!content) return;
    const newS = {
      id: 's_' + Date.now(),
      name: 'Nama Narasumber',
      title: 'Jabatan / Keahlian',
      company: 'Instansi / Perusahaan',
      photoUrl: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?w=400&auto=format&fit=crop&q=80'
    };
    setContent({ ...content, speakers: [...(content.speakers || []), newS] });
  };

  const handleUpdateSpeaker = (index: number, field: string, value: string) => {
    if (!content) return;
    const updated = [...(content.speakers || [])];
    updated[index] = { ...updated[index], [field]: value };
    setContent({ ...content, speakers: updated });
  };

  const handleDeleteSpeaker = (index: number) => {
    if (!content) return;
    const updated = (content.speakers || []).filter((_, i) => i !== index);
    setContent({ ...content, speakers: updated });
  };

  const handleAddAgenda = () => {
    if (!content) return;
    const newA = {
      id: 'a_' + Date.now(),
      time: '12:00 - 12:30',
      title: 'Nama Sesi Acara',
      description: 'Penjelasan singkat aktivitas di sesi ini.'
    };
    setContent({ ...content, agenda: [...(content.agenda || []), newA] });
  };

  const handleUpdateAgenda = (index: number, field: string, value: string) => {
    if (!content) return;
    const updated = [...(content.agenda || [])];
    updated[index] = { ...updated[index], [field]: value };
    setContent({ ...content, agenda: updated });
  };

  const handleDeleteAgenda = (index: number) => {
    if (!content) return;
    const updated = (content.agenda || []).filter((_, i) => i !== index);
    setContent({ ...content, agenda: updated });
  };

  const handleAddFaq = () => {
    if (!content) return;
    const newF = {
      question: 'Pertanyaan baru?',
      answer: 'Jawaban penjelasan untuk pertanyaan ini.'
    };
    setContent({ ...content, faq: [...(content.faq || []), newF] });
  };

  const handleUpdateFaq = (index: number, field: 'question' | 'answer', value: string) => {
    if (!content) return;
    const updated = [...(content.faq || [])];
    updated[index] = { ...updated[index], [field]: value };
    setContent({ ...content, faq: updated });
  };

  const handleDeleteFaq = (index: number) => {
    if (!content) return;
    const updated = (content.faq || []).filter((_, i) => i !== index);
    setContent({ ...content, faq: updated });
  };

  const handleAddGallery = () => {
    if (!content) return;
    const newG = {
      id: 'g_' + Date.now(),
      url: 'https://images.unsplash.com/photo-1511578314322-379afb476865?w=800&auto=format&fit=crop&q=80',
      title: 'Foto Dokumentasi Acara Baru',
      caption: 'Penjelasan singkat aktivitas atau momen foto dokumentasi gathering.'
    };
    setContent({ ...content, gallery: [...(content.gallery || []), newG] });
  };

  const handleUpdateGallery = (index: number, field: string, value: string) => {
    if (!content) return;
    const updated = [...(content.gallery || [])];
    updated[index] = { ...updated[index], [field]: value };
    setContent({ ...content, gallery: updated });
  };

  const handleDeleteGallery = (index: number) => {
    if (!content) return;
    const updated = (content.gallery || []).filter((_, i) => i !== index);
    setContent({ ...content, gallery: updated });
  };

  const handleAddService = () => {
    if (!content) return;
    const updated = [...(content.footerServices || []), 'Layanan Baru'];
    setContent({ ...content, footerServices: updated });
  };

  const handleUpdateService = (index: number, value: string) => {
    if (!content) return;
    const updated = [...(content.footerServices || [])];
    updated[index] = value;
    setContent({ ...content, footerServices: updated });
  };

  const handleDeleteService = (index: number) => {
    if (!content) return;
    const updated = (content.footerServices || []).filter((_, i) => i !== index);
    setContent({ ...content, footerServices: updated });
  };

  // Filtered Participants Calculation
  const filteredParticipants = participants.filter(p => {
    const q = searchQuery.trim().toLowerCase();
    const matchesStatus = statusFilter === 'ALL' || p.status === statusFilter;
    const matchesBranchFilter = branchFilter === 'ALL' || (p.branch || '').toLowerCase().includes(branchFilter.toLowerCase());

    if (!q) {
      return matchesStatus && matchesBranchFilter;
    }

    const cleanQueryDigits = q.replace(/\D/g, '');
    const cleanPhone = p.phone.replace(/\D/g, '');

    const matchesName = p.fullName.toLowerCase().includes(q);
    const matchesPhone = p.phone.toLowerCase().includes(q) || (cleanQueryDigits.length >= 2 && cleanPhone.includes(cleanQueryDigits));
    const matchesEmail = p.email.toLowerCase().includes(q);
    const matchesCode = p.registrationCode.toLowerCase().includes(q);
    const matchesBranch = (p.branch || '').toLowerCase().includes(q);

    const matchesSearch = matchesName || matchesPhone || matchesEmail || matchesCode || matchesBranch;

    return matchesSearch && matchesStatus && matchesBranchFilter;
  });

  // --- SELECTION & BATCH DELETE PARTICIPANTS ---
  const isAllSelected = filteredParticipants.length > 0 && filteredParticipants.every(p => selectedParticipantIds.includes(p.id));

  const handleToggleSelectAll = () => {
    if (isAllSelected) {
      const filteredIdsSet = new Set(filteredParticipants.map(p => p.id));
      setSelectedParticipantIds(prev => prev.filter(id => !filteredIdsSet.has(id)));
    } else {
      const filteredIds = filteredParticipants.map(p => p.id);
      setSelectedParticipantIds(prev => Array.from(new Set([...prev, ...filteredIds])));
    }
  };

  const handleToggleSelectParticipant = (id: string) => {
    setSelectedParticipantIds(prev =>
      prev.includes(id) ? prev.filter(i => i !== id) : [...prev, id]
    );
  };

  const cancelledParticipantsCount = participants.filter(p => p.status === 'Cancelled').length;

  const totalSeats = participants.reduce((sum, p) => sum + (p.attendanceCount || 1), 0);
  const totalVerified = participants.filter(p => p.status === 'Verified' || p.status === 'Attended').length;

  return (
    <div className="min-h-screen bg-slate-100 text-slate-800 flex flex-col font-sans">
      
      {/* Top Navigation Bar */}
      <header className="bg-emerald-950 text-white border-b border-amber-400/30 sticky top-0 z-40 shadow-md">
        <div className="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-2.5 sm:py-3 flex flex-wrap sm:flex-nowrap items-center justify-between gap-3">
          
          <div className="flex items-center gap-2.5">
            <div className="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-amber-400 text-emerald-950 font-black flex items-center justify-center text-xs sm:text-sm shadow-sm shrink-0">
              ITO
            </div>
            <div>
              <div className="flex items-center gap-1.5 flex-wrap">
                <span className="font-extrabold text-sm sm:text-base tracking-tight text-white">Panel Admin</span>
                <span className="text-[9px] sm:text-[10px] bg-amber-400/20 text-amber-300 font-bold px-1.5 py-0.5 rounded border border-amber-400/30">
                  ito31102002
                </span>
              </div>
              <p className="text-[10px] sm:text-[11px] text-emerald-300 truncate max-w-[180px] sm:max-w-none">Mini Gathering Emas Pegadaian</p>
            </div>
          </div>

          <div className="flex items-center gap-2 ml-auto sm:ml-0">
            <button
              onClick={() => setShowQrScanner(true)}
              className="relative group px-3 py-1.5 sm:px-3.5 sm:py-1.5 rounded-xl bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-emerald-950 font-black text-xs flex items-center gap-1.5 shadow-md hover:shadow-lg hover:shadow-amber-400/20 transition-all duration-200 cursor-pointer border border-amber-200/80 overflow-hidden shrink-0"
            >
              <span className="absolute inset-0 w-full h-full bg-white/20 group-hover:translate-x-full transition-transform duration-700 ease-out -translate-x-full" />
              <QrCode className="relative w-4 h-4 text-emerald-950 shrink-0" />
              <span className="relative font-extrabold tracking-tight">Scan QR</span>
            </button>

            <button
              onClick={fetchData}
              className="p-2 rounded-xl bg-emerald-900 hover:bg-emerald-800 text-emerald-200 transition-colors cursor-pointer shrink-0"
              title="Refresh Data"
            >
              <RefreshCw className={`w-4 h-4 ${loading ? 'animate-spin' : ''}`} />
            </button>

            <button
              onClick={onLogout}
              className="px-2.5 py-1.5 sm:px-3.5 sm:py-1.5 rounded-xl bg-rose-600/80 hover:bg-rose-600 text-white font-semibold text-xs flex items-center gap-1 transition-colors cursor-pointer shrink-0"
              title="Keluar dari Admin"
            >
              <LogOut className="w-3.5 h-3.5" />
              <span className="hidden xs:inline">Keluar</span>
            </button>
          </div>

        </div>

        {/* Admin Tabs Bar */}
        <div className="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 flex items-center gap-1.5 sm:gap-2 overflow-x-auto border-t border-emerald-900/60 pt-1.5 pb-2 no-scrollbar scroll-smooth">
          <button
            onClick={() => setActiveTab('participants')}
