          <div className="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-rose-100 space-y-5 animate-scale-up">
            <div className="flex items-start gap-4">
              <div className="w-12 h-12 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0 border border-rose-200 shadow-xs">
                <Trash2 className="w-6 h-6" />
              </div>
              <div>
                <h3 className="text-lg font-extrabold text-slate-900">{deleteConfirmModal.title}</h3>
                <p className="text-xs text-slate-600 mt-1 leading-relaxed">{deleteConfirmModal.description}</p>
              </div>
            </div>

            {/* Preview Participant List */}
            {deleteConfirmModal.itemsPreview.length > 0 && (
              <div className="bg-slate-50 rounded-2xl p-3 border border-slate-200 max-h-48 overflow-y-auto space-y-2">
                <p className="text-[10px] font-extrabold text-slate-500 uppercase tracking-wider">
                  Daftar Peserta Yang Akan Dihapus ({deleteConfirmModal.ids.length}):
                </p>
                {deleteConfirmModal.itemsPreview.slice(0, 5).map(item => (
                  <div key={item.id} className="flex items-center justify-between bg-white p-2 rounded-xl border border-slate-200/80 text-xs shadow-2xs">
                    <div>
                      <span className="font-bold text-slate-900 block">{item.name}</span>
                      <span className="text-[10px] text-slate-500 block">{item.branch} • Tiket: {item.code}</span>
                    </div>
                    <span className={`text-[10px] font-bold px-2 py-0.5 rounded-lg border ${
                      item.status === 'Verified' ? 'bg-emerald-100 text-emerald-800 border-emerald-300' :
                      item.status === 'Attended' ? 'bg-blue-100 text-blue-800 border-blue-300' :
                      item.status === 'Cancelled' ? 'bg-rose-100 text-rose-800 border-rose-300' :
                      'bg-amber-100 text-amber-800 border-amber-300'
                    }`}>
                      {item.status}
                    </span>
                  </div>
                ))}
                {deleteConfirmModal.ids.length > 5 && (
                  <p className="text-center text-xs font-semibold text-slate-500 pt-1">
                    + {deleteConfirmModal.ids.length - 5} peserta lainnya
                  </p>
                )}
              </div>
            )}

            <div className="bg-amber-50 border border-amber-200 rounded-xl p-3 text-[11px] text-amber-900 flex items-start gap-2">
              <AlertTriangle className="w-4 h-4 text-amber-600 shrink-0 mt-0.5" />
              <p>Data peserta yang dihapus tidak dapat dikembalikan. Kuota pendaftaran akan kembali terbuka otomatis di server.</p>
            </div>

            <div className="flex items-center justify-end gap-2.5 pt-2 border-t border-slate-100">
              <button
                onClick={() => setDeleteConfirmModal(null)}
                disabled={deleteConfirmModal.isDeleting}
                className="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 font-bold text-slate-700 text-xs transition-colors cursor-pointer"
              >
                Batalkan
              </button>
              <button
                onClick={executeDeleteConfirm}
                disabled={deleteConfirmModal.isDeleting}
                className="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs flex items-center gap-2 shadow-md transition-all cursor-pointer disabled:opacity-50"
              >
                {deleteConfirmModal.isDeleting ? (
                  <>
                    <Loader2 className="w-4 h-4 animate-spin" />
                    Menghapus...
                  </>
                ) : (
                  <>
                    <Trash2 className="w-4 h-4" />
                    Ya, Hapus ({deleteConfirmModal.ids.length}) Peserta
                  </>
                )}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* QR Check-In Scanner Modal */}
      <QrCheckInModal
        isOpen={showQrScanner}
        onClose={() => setShowQrScanner(false)}
        participants={participants}
        onUpdateStatus={handleUpdateStatus}
      />

    </div>
  );
};
